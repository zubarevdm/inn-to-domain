# --- Карточка организации по ИНН (DaData Suggestions, бесплатный тариф) ---
DADATA_TOKEN=

# --- LLM: GigaChat (Сбер) ---
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Сертификаты НУЦ Минцифры часто не установлены в системе. Либо false, либо путь к бандлу.
GIGACHAT_VERIFY_SSL=false

# --- Web Search ---
SEARCH_PROVIDER=yandex          # yandex | exa
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
EXA_API_KEY=

# --- Прочее ---
# Клиент по умолчанию игнорирует системный прокси (VPN ломает доступ к GigaChat).
HTTP_TRUST_ENV=false
CACHE_TTL_DAYS=14
